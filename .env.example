# Local Docker Compose settings. Copy to .env and replace the development values.

# PostgreSQL
DB_NAME=kithlore
DB_USER=kithlore
DB_PASSWORD=change-me-local-database-password

# Published host ports
API_PORT=8081
WEB_PORT=4200

# Spring profile and signed session token secret (use at least 32 random bytes)
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=replace-with-at-least-32-random-bytes-before-sharing

# LLM provider selection: anthropic, openai, or openai-compatible
LLM_PROVIDER_PRIMARY=anthropic
LLM_PROVIDER_FALLBACK=openai
LLM_MODEL_NARRATION=
LLM_MODEL_SUMMARY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Per-room daily token ceiling and maximum context size
ROOM_DAILY_TOKEN_CAP=500000
CONTEXT_MAX_TOKENS=12000
